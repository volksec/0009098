# Copie para .env e defina valores locais:  cp .env.example .env
# O .env é ignorado pelo git — nenhuma credencial, nem de desenvolvimento, é versionada.

POSTGRES_APP_USER_PASSWORD=troque_este_valor_local
POSTGRES_APP_REGULATOR_PASSWORD=troque_este_valor_local
POSTGRES_APP_WORKER_PASSWORD=troque_este_valor_local
